# MeisterStack dev environment — copy to deploy/env and fill in your lab.
# deploy/env is gitignored; every deploy/*.sh sources it (override the path
# with MEISTER_ENV=...). One file = one environment; keep several (env.lab,
# env.local) and point MEISTER_ENV at the one you are using.

# `set -a`, and it is not decoration. This file has two kinds of reader, and
# only one of them is the shell that sourced it: `push.sh` and `check.sh` run
# IN that shell and read the names below directly, while `meister-deploy` is a
# CHILD PROCESS and reads them out of the ENVIRONMENT — which a bare
# assignment does not put them in.
#
# Measured on 2026-09-10 with a file that lacked this line:
# `. deploy/env; meister-deploy plan` ran on StrictHostKeyChecking=accept-new,
# because MEISTER_SSH_STRICT never reached the process, and reported all
# twelve nodes of a healthy fleet as "not reachable over ssh". The tool's own
# help promises these variables mean in front of it what they mean in front of
# the scripts; this line is what makes that true. Keep it in your own copy.
set -a

# The control-plane VMs (as assigned by OpenNebula / your IP pool). Both tiers
# are HA since M4.6, so these are space-separated LISTS: push.sh walks every
# address, and a list that names one replica of three leaves the other two on
# the old binary. The singular MEISTER_CLOUD_IP / MEISTER_CLUSTER_IP still
# work for a single-replica lab.
MEISTER_CLOUD_IPS="10.128.1.103"
# every cluster-controller of every cluster, not just cluster-1
MEISTER_CLUSTER_IPS="10.128.1.104"

# SSH into the VMs (the context installs SSH_PUBLIC_KEY for root)
MEISTER_SSH_USER=root
MEISTER_SSH_KEY=$HOME/.ssh/id_ed25519
# MEISTER_SSH_PORT=22    # override for tunnels/port-forward setups
# MEISTER_SSH_STRICT=no  # throwaway VMs: don't pin host keys

# OpenNebula frontend, only used by convenience helpers / documentation
ONE_FRONTEND=10.0.8.21

# Where the agent runs and how it reaches the cluster-controller later
# (goes into config/agent.dev.toml -> controller_addr once Stage 2 M1 lands)
MEISTER_AGENT_NODE=manacor

# Lab agent VMs (testenv): push.sh agents deploys agent + musl-CH + guest
# assets to each of these
MEISTER_AGENT_IPS=""
MEISTER_GUEST_ASSETS=/mnt/vmstore/MeisterStack/images
# Which guest assets travel. m51-initrd carries the virtio core modules the
# M5.1 network proofs need; a file that is not in MEISTER_GUEST_ASSETS is
# warned about and skipped, not fatal.
# MEISTER_GUEST_FILES="vmlinux.elf tiny-initrd tiny-volume.raw m51-initrd"

# Where the certificates come from. `deploy/push.sh pki` reads this directory
# and gives each host what belongs to it: ca.crt everywhere, <hostname>.crt/.key
# as serving.* to the controller replicas, system-cluster-<name>.* and
# system-node-<node_id>.* as identity.*. The generator is tools/meister-ca, and
# it is idempotent — a missing identity is generated, not worked around.
# MEISTER_PKI_DIR=/mnt/vmstore/MeisterStack/labpki
set +a
