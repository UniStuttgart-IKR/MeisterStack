#!/usr/bin/env bash
#
# meister-ca — the lab's certificate authority, in one file.
#
# Everything this control plane authenticates with comes out of here: the
# controllers' serving certificates, the nodes' and clusters' system
# identities, the break-glass admin, and ordinary users. openssl rather than
# a Rust binary on purpose — this is the one tool an operator has to be able
# to read line by line before trusting it with a CA key, and `nix shell
# nixpkgs#openssl` is the only prerequisite.
#
# Idempotent by design: an existing CA is reused, an existing identity is
# left exactly as it is, and re-running with more --node/--user adds only
# what is missing. Nothing here ever overwrites a private key without
# --force, because the certificate that key belongs to is deployed somewhere.
#
# The identity model is Kubernetes': CN is the name, O is the group.
#
#   controllers  CN=<name>              O=system:controllers   (serverAuth+clientAuth)
#   nodes        CN=system:node:<id>    O=system:nodes
#   clusters     CN=system:cluster:<n>  O=system:clusters
#   clouds       CN=system:cloud:<n>    O=system:clouds
#   admin        CN=<name>              O=system:masters       (break glass)
#   users        CN=<name>              O=meister:admins|operators|members|viewers
#
# `system:masters` is above the user directory and answers to no User object.
# It exists because the directory has a bootstrap problem — somebody has to
# create the first user — and it is meant to be used twice and then left
# alone. Ordinary users get their certificates from `meister login`; the
# --user form here is for a lab that wants one without a running API.

set -euo pipefail

DIR="pki"
CA_DAYS=3650
DAYS=90
FORCE=0
CURVE="prime256v1"

CLOUDS=(); CLUSTERS=(); NODES=(); ADMINS=(); USERS=()
SERVINGS=(); CLOUD_IDS=(); CLUSTER_IDS=()
# The CSR path: a request somebody else made, signed here. No key is
# generated for it and none is wanted -- that is the point of a request.
SIGN_CSR=""; SIGN_KIND=""; SIGN_NAME=""; SIGN_SAN=""; SIGN_OUT=""
# --- lane 5A: the index, the revocations and the list ----------------------
# A CA that cannot say what it signed cannot take it back: `openssl ca
# -revoke` writes into index.txt and nowhere else, and this script has never
# had one (it signs with `openssl x509 -req -CAcreateserial`). So the index is
# rebuilt from the certificates themselves, ADDITIVELY.
INDEX_REBUILD=0; REVOKE=""; REVOKE_REASON=""; GENCRL=0; CRL_DAYS=30

usage() {
	cat <<'USAGE'
usage: meister-ca [options]

  --dir DIR              where the CA and the certificates live (default: pki)
  --days N               lifetime of issued certificates (default: 90)
  --ca-days N            lifetime of the CA itself (default: 3650)
  --force                reissue identities that already exist
  --curve NAME           EC curve (default: prime256v1)

  --cloud   NAME[:SAN,...]   a cloud-controller: serving certificate AND the
                             system:cloud identity its replicas show each other
  --cluster NAME[:SAN,...]   a cluster-controller: serving certificate AND the
                             system:cluster identity it dials the cloud with

  The two above are the hand-typed form, where one host IS one tier. A fleet
  with replicas needs the halves apart -- a serving certificate belongs to a
  HOST and a tier identity to the GROUP of hosts that share it -- so:

  --serving NAME[:SAN,...]   only the serving certificate of one host
  --cloud-identity NAME      only the system:cloud identity of one cloud
  --cluster-identity NAME    only the system:cluster identity of one cluster
  --node    NODE_ID          an agent's system:node identity
  --admin   NAME             a break-glass system:masters certificate
  --user    NAME[:ROLE]      a user certificate (ROLE: admin|operator|member|viewer,
                             default member). The group is LABELLING, not a
                             permission: the cloud reads the role off the User
                             object in its directory on every request.

  Every form above makes a key AND a certificate, which is right for a lab
  where this script is the only thing that exists. A fleet does it the other
  way round: the key is made on the machine that will use it
  (`meister-activate keygen`) and only the request travels. Then:

  --sign-csr FILE            sign a request somebody else made. Generates NO
                             key: what is signed is the public half in the
                             request, and the private half never was here.
  --kind KIND                node | cluster | cloud | serving -- which subject
                             and which extensions the certificate gets. The CA
                             decides the subject; the CN in the request is a
                             request.
  --name NAME                what the subject is built from: the node id, the
                             cluster/cloud name, or the host name for serving
  --san LIST                 extra SANs for --kind serving (comma separated)
  --out FILE                 where the certificate goes
                             (default: <dir>/issued/<name>-<kind>.crt)

  Taking one back. A certificate is revoked in the CA's own index and
  published in a list; `meister-deploy keys revoke` drives both and then
  delivers the list to every host that reads one.

  --index-rebuild            write <dir>/{index.txt,crlnumber,serial,openssl.cnf}
                             and add a row for every certificate under <dir>
                             and <dir>/issued that has none. ADDITIVE: a
                             serial already in the index keeps the row it has,
                             so no rebuild can lose a revocation.
  --revoke CRT|SERIAL        mark one certificate revoked. A path is revoked
                             by openssl itself; a bare serial is looked up in
                             the index, which is what a certificate nobody
                             kept a copy of leaves behind.
  --reason NAME              keyCompromise | superseded | cessationOfOperation |
                             affiliationChanged | privilegeWithdrawn | unspecified
  --gencrl                   write <dir>/crl.pem from the index
  --crl-days N               how long that list is current (default: 30)

SANs are the addresses clients will use: bare names become DNS entries,
anything that parses as an address becomes an IP entry. "localhost" and
"127.0.0.1" are always added, because that is how the local recipes reach it.

Every identity gets <dir>/<name>.key, <dir>/<name>.crt and a copy-paste
bundle at <dir>/bundle/<name>.md holding the TOML fragment and the NixOS
snippet for it.

examples:
  meister-ca --cloud meister-cloud:10.128.1.103 \
             --cluster cluster-1:10.128.1.104 \
             --node manacor --admin root --user alice:member
USAGE
}

die() { printf 'meister-ca: %s\n' "$*" >&2; exit 1; }
note() { printf '  %s\n' "$*" >&2; }

while [ $# -gt 0 ]; do
	case "$1" in
		--dir)     DIR="$2"; shift 2 ;;
		--days)    DAYS="$2"; shift 2 ;;
		--ca-days) CA_DAYS="$2"; shift 2 ;;
		--curve)   CURVE="$2"; shift 2 ;;
		--force)   FORCE=1; shift ;;
		--cloud)   CLOUDS+=("$2"); shift 2 ;;
		--cluster) CLUSTERS+=("$2"); shift 2 ;;
		--serving)          SERVINGS+=("$2"); shift 2 ;;
		--cloud-identity)   CLOUD_IDS+=("$2"); shift 2 ;;
		--cluster-identity) CLUSTER_IDS+=("$2"); shift 2 ;;
		--node)    NODES+=("$2"); shift 2 ;;
		--admin)   ADMINS+=("$2"); shift 2 ;;
		--user)    USERS+=("$2"); shift 2 ;;
		--sign-csr) SIGN_CSR="$2"; shift 2 ;;
		--kind)     SIGN_KIND="$2"; shift 2 ;;
		--name)     SIGN_NAME="$2"; shift 2 ;;
		--san)      SIGN_SAN="$2"; shift 2 ;;
		--out)      SIGN_OUT="$2"; shift 2 ;;
		--index-rebuild) INDEX_REBUILD=1; shift ;;
		--revoke)   REVOKE="$2"; shift 2 ;;
		--reason)   REVOKE_REASON="$2"; shift 2 ;;
		--gencrl)   GENCRL=1; shift ;;
		--crl-days) CRL_DAYS="$2"; shift 2 ;;
		-h|--help) usage; exit 0 ;;
		*) die "unknown option $1 (try --help)" ;;
	esac
done

command -v openssl >/dev/null || die "openssl is not on PATH (try: nix shell nixpkgs#openssl)"

mkdir -p "$DIR" "$DIR/bundle"
CA_KEY="$DIR/ca.key"
CA_CRT="$DIR/ca.crt"

# --- the CA ----------------------------------------------------------------
#
# Reused if it is there. This is the half of "idempotent" that matters: every
# certificate already deployed chains to this key, and replacing it would
# quietly invalidate all of them.
if [ -f "$CA_KEY" ] && [ -f "$CA_CRT" ]; then
	note "ca: reusing $CA_CRT"
elif [ -f "$CA_KEY" ] || [ -f "$CA_CRT" ]; then
	die "half a CA in $DIR (one of ca.key/ca.crt is missing); refusing to guess"
else
	note "ca: creating $CA_CRT"
	( umask 077; openssl genpkey -quiet -algorithm EC \
		-pkeyopt "ec_paramgen_curve:$CURVE" -out "$CA_KEY" )
	openssl req -x509 -new -key "$CA_KEY" -sha256 -days "$CA_DAYS" -out "$CA_CRT" \
		-subj "/CN=meister-ca" \
		-addext "basicConstraints=critical,CA:TRUE" \
		-addext "keyUsage=critical,keyCertSign,cRLSign" \
		-addext "subjectKeyIdentifier=hash"
fi

# issue <file-stem> <subject> <extensions-block>
issue() {
	local stem="$1" subj="$2" exts="$3"
	local key="$DIR/$stem.key" crt="$DIR/$stem.crt"

	if [ -f "$crt" ] && [ "$FORCE" -eq 0 ]; then
		note "$stem: already there ($(openssl x509 -in "$crt" -noout -enddate | cut -d= -f2))"
		return 0
	fi
	( umask 077; openssl genpkey -quiet -algorithm EC \
		-pkeyopt "ec_paramgen_curve:$CURVE" -out "$key" )
	local csr ext
	csr="$(mktemp)"; ext="$(mktemp)"
	printf '%s\n' "$exts" > "$ext"
	openssl req -new -key "$key" -out "$csr" -subj "$subj"
	openssl x509 -req -in "$csr" -CA "$CA_CRT" -CAkey "$CA_KEY" -CAcreateserial \
		-out "$crt" -days "$DAYS" -sha256 -extfile "$ext" 2>/dev/null
	rm -f "$csr" "$ext"
	note "$stem: issued, $subj"
}

# Bare names become DNS entries, anything that looks like an address an IP
# entry. Both loopbacks are always in, because that is how every local recipe
# in this repo reaches a controller.
sans_of() {
	local list="$1" out="DNS:localhost,IP:127.0.0.1" san
	IFS=',' read -r -a extra <<< "${list:-}"
	for san in "${extra[@]:-}"; do
		[ -n "$san" ] || continue
		if [[ "$san" =~ ^[0-9.]+$ || "$san" == *:* ]]; then
			out="$out,IP:$san"
		else
			out="$out,DNS:$san"
		fi
	done
	printf '%s' "$out"
}

SERVER_EXTS='basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth,clientAuth
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid,issuer'

CLIENT_EXTS='basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=clientAuth
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid,issuer'

# --- signing a request somebody else made ----------------------------------
#
# The other half of `meister-activate keygen`: the key was made on the machine
# that will use it, and what arrives here is a public key and a name. This
# branch generates nothing -- there is no `genpkey` in it -- and it is the only
# path in this script that ends with a certificate whose private half was never
# on this computer.
#
# The SUBJECT is ours. `openssl x509 -req -subj` overwrites the CN the request
# carries, and no `-copy_extensions` is passed, so nothing the requester wrote
# reaches the certificate: a request is a request. That is what makes it safe
# to accept one from a machine that is being enrolled for the first time.
if [ -n "$SIGN_CSR" ]; then
	[ -f "$SIGN_CSR" ] || die "no such certificate request: $SIGN_CSR"
	[ -n "$SIGN_NAME" ] || die "--sign-csr needs --name (what the subject is built from)"
	case "$SIGN_KIND" in
		node)    subj="/CN=system:node:$SIGN_NAME/O=system:nodes"       ; exts="$CLIENT_EXTS" ;;
		cluster) subj="/CN=system:cluster:$SIGN_NAME/O=system:clusters" ; exts="$CLIENT_EXTS" ;;
		cloud)   subj="/CN=system:cloud:$SIGN_NAME/O=system:clouds"     ; exts="$CLIENT_EXTS" ;;
		serving) subj="/CN=$SIGN_NAME/O=system:controllers"
		         exts="$SERVER_EXTS
subjectAltName=$(sans_of "$SIGN_SAN")" ;;
		"") die "--sign-csr needs --kind (node|cluster|cloud|serving)" ;;
		*)  die "unknown --kind $SIGN_KIND (node|cluster|cloud|serving)" ;;
	esac
	[ "$SIGN_KIND" = "serving" ] || [ -z "$SIGN_SAN" ] || \
		die "--san is only for --kind serving: a client certificate is checked on its CN"

	# The request has to be signed by the key it carries, or it is a form and
	# not a request: without this, anybody could submit somebody else's public
	# key under their own name and have this CA vouch for a key they do not
	# hold. `meister-deploy keys issue` checks the same thing before it gets
	# here; this is the CA's own answer, for an operator who runs the script
	# by hand.
	openssl req -in "$SIGN_CSR" -noout -verify >/dev/null 2>&1 \
		|| die "$SIGN_CSR is not signed by the key it carries"

	out="${SIGN_OUT:-$DIR/issued/$SIGN_NAME-$SIGN_KIND.crt}"
	kept="$DIR/issued/$SIGN_NAME-$SIGN_KIND.crt"
	mkdir -p "$(dirname "$out")" "$DIR/issued"

	# Astra finding F12, 2026-09-23: both paths below are keyed on
	# name+kind, not on the certificate -- when `--out` is not given `$out`
	# IS `$kept`, and openssl's `-out` truncates whatever is already there
	# before this function ever reaches the `cp` a few lines down. A
	# re-issue for a name+kind already on disk used to destroy the only
	# copy this CA had of the earlier certificate, silently, and with it
	# the one thing `--index-rebuild` could later find to revoke by. Each
	# side that might already hold an earlier certificate is moved aside
	# under ITS OWN serial before anything is written, so no certificate
	# this CA once signed is ever overwritten.
	archive_aside() {
		local f="$1" old_serial aside
		[ -f "$f" ] || return 0
		old_serial="$(openssl x509 -in "$f" -noout -serial 2>/dev/null | cut -d= -f2)"
		[ -n "$old_serial" ] || return 0
		aside="$DIR/issued/$SIGN_NAME-$SIGN_KIND-$old_serial.crt"
		[ "$f" = "$aside" ] && return 0
		# `$out` and `$kept` can hold an identical copy of the same
		# superseded certificate (an earlier run's `cp` made them byte for
		# byte the same); once one side has archived it, the other side has
		# nothing left to preserve, and is about to be overwritten anyway.
		[ -e "$aside" ] && return 0
		mv "$f" "$aside"
		note "archived: $aside (superseded)"
	}
	archive_aside "$out"
	[ "$out" -ef "$kept" ] 2>/dev/null || archive_aside "$kept"

	ext="$(mktemp)"
	printf '%s\n' "$exts" > "$ext"
	# ADDITIVE: every issued certificate stays where it was written, because
	# `--index-rebuild` (M5A) reads exactly these files to reconstruct
	# index.txt, and a revocation that is not in the index is not a
	# revocation (M0 probe S9).
	openssl x509 -req -in "$SIGN_CSR" -CA "$CA_CRT" -CAkey "$CA_KEY" -CAcreateserial \
		-out "$out" -days "$DAYS" -sha256 -extfile "$ext" -subj "$subj" 2>/dev/null \
		|| { rm -f "$ext"; die "openssl refused to sign $SIGN_CSR"; }
	rm -f "$ext"
	serial="$(openssl x509 -in "$out" -noout -serial | cut -d= -f2)"
	# The CA keeps its own copy, wherever --out sent the certificate. A CA
	# that cannot say what it signed cannot take it back: `--index-rebuild`
	# reads exactly these two directories, and `meister-deploy keys issue`
	# passes an --out under the operator's REPOSITORY — so without this copy
	# every certificate of the fleet would be outside the index and outside
	# every revocation.
	[ "$out" -ef "$kept" ] 2>/dev/null || cp "$out" "$kept"
	note "signed: $subj"
	note "serial: $serial"
	note "        $out"
	printf '%s\n' "$out"
	exit 0
fi

# --- lane 5A: the index, the revocations and the list ----------------------
#
# Three verbs over one file. `openssl ca` is the only openssl subcommand that
# revokes and the only one that writes a CRL, and it insists on a database:
# `index.txt`, one row per certificate this CA has ever signed. This script
# never had one, because it signs with `openssl x509 -req` — so the index is
# reconstructed from the certificates themselves.
#
# The rebuild is ADDITIVE and that is the whole safety property: an `R` row is
# the ONLY record that something was revoked (the certificate on disk looks
# exactly as it did before), so a rebuild that rewrote the file from the
# `*.crt` would quietly un-revoke every one of them. Measured in M0 probe S9,
# and `scripts/check-ca-revoke.sh` holds it.

INDEX="$DIR/index.txt"
CNF="$DIR/openssl.cnf"

# openssl resolves the paths in a config against the CURRENT DIRECTORY, and
# this script is run from wherever an operator happens to stand. So the
# config carries absolute paths and nothing in it depends on the caller's cwd.
ca_abs() { (cd "$DIR" && pwd); }

write_cnf() {
	local abs; abs="$(ca_abs)"
	cat > "$CNF" <<CNF
# Written by meister-ca --index-rebuild. Only 'openssl ca -revoke' and
# 'openssl ca -gencrl' read it; nothing here issues certificates.
[ ca ]
default_ca = meister

[ meister ]
database         = $abs/index.txt
crlnumber        = $abs/crlnumber
serial           = $abs/serial
new_certs_dir    = $abs/newcerts
certificate      = $abs/ca.crt
private_key      = $abs/ca.key
default_md       = sha256
default_days     = $DAYS
default_crl_days = $CRL_DAYS
policy           = policy_any
email_in_dn      = no
unique_subject   = no

# The subjects this CA writes carry a CN and an O and nothing else, and a
# policy that demanded more would refuse to record its own certificates.
[ policy_any ]
commonName             = supplied
organizationName       = optional
organizationalUnitName = optional
countryName            = optional
stateOrProvinceName    = optional
localityName           = optional
CNF
}

# The five tab-separated fields openssl's own index writer uses:
#   V <notAfter YYMMDDHHMMSSZ> <revocation date> <serial> unknown <subject>
index_add() {
	local crt="$1" serial notafter stamp subject
	serial="$(openssl x509 -in "$crt" -noout -serial 2>/dev/null | cut -d= -f2)" || return 0
	[ -n "$serial" ] || return 0
	if cut -f4 "$INDEX" | grep -qx "$serial"; then
		return 0
	fi
	notafter="$(openssl x509 -in "$crt" -noout -enddate | cut -d= -f2-)"
	stamp="$(date -u -d "$notafter" +%y%m%d%H%M%SZ)"
	# `compat` is the slash form openssl's index writer produces.
	subject="$(openssl x509 -in "$crt" -noout -subject -nameopt compat | sed 's/^subject=//')"
	printf 'V\t%s\t\t%s\tunknown\t%s\n' "$stamp" "$serial" "$subject" >> "$INDEX"
	note "index: + $serial $subject"
}

index_rebuild() {
	mkdir -p "$DIR/newcerts" "$DIR/issued"
	[ -f "$INDEX" ] || : > "$INDEX"
	printf 'unique_subject = no\n' > "$DIR/index.txt.attr"
	[ -f "$DIR/crlnumber" ] || printf '01\n' > "$DIR/crlnumber"
	[ -f "$DIR/serial" ] || printf '01\n' > "$DIR/serial"
	write_cnf
	local crt
	# Both layouts: the hand-typed one writes <dir>/<stem>.crt, --sign-csr
	# keeps its copy under <dir>/issued/ (3B finding N3/G4). A nested
	# directory under issued/ is read too, so a copy of an operator's
	# repository can be dropped in whole.
	for crt in "$DIR"/*.crt; do
		[ -f "$crt" ] || continue
		case "$(basename "$crt")" in ca.crt) continue ;; esac
		index_add "$crt"
	done
	if [ -d "$DIR/issued" ]; then
		while IFS= read -r crt; do
			[ -n "$crt" ] || continue
			index_add "$crt"
		done < <(find "$DIR/issued" -type f -name '*.crt' | sort)
	fi
}

# A serial rather than a file. `openssl ca` has no way to revoke one — it
# wants the certificate — and a certificate whose host was reinstalled is
# exactly the one nobody kept. The row is already in the index (that is what
# the rebuild is for), so this is the same edit openssl would make: V -> R,
# with the date and the reason in the third field.
#
# The comparison ignores case, colons and leading zeros, because the three
# spellings of one serial in this stack are openssl's (upper, no separator),
# x509-parser's (lower, colons -- what a receipt from a controller carries)
# and whatever an operator retypes.
revoke_serial() {
	local want="$1" reason="$2" now rc=0
	now="$(date -u +%y%m%d%H%M%SZ)"
	awk -F'\t' -v OFS='\t' -v want="$want" -v now="$now" -v reason="$reason" '
		function norm(s) { gsub(/[: ]/, "", s); s = toupper(s); sub(/^0+/, "", s); return s }
		norm($4) == norm(want) {
			if ($1 == "R") { found = 2; print; next }
			$1 = "R"; $3 = (reason == "" ? now : now "," reason)
			found = 1; print; next
		}
		{ print }
		END { exit (found == 1 ? 0 : (found == 2 ? 3 : 4)) }
	' "$INDEX" > "$INDEX.tmp" || rc=$?
	case "$rc" in
		0) mv "$INDEX.tmp" "$INDEX"; note "revoked: $want" ;;
		3) rm -f "$INDEX.tmp"; note "already revoked: $want" ;;
		4) rm -f "$INDEX.tmp"
		   die "no certificate with serial $want is in $INDEX. This CA can only revoke what it knows it signed: put the certificate under $DIR/issued/ and run --index-rebuild first." ;;
		*) rm -f "$INDEX.tmp"; die "rewriting $INDEX failed" ;;
	esac
}

if [ "$INDEX_REBUILD" -eq 1 ] || [ -n "$REVOKE" ] || [ "$GENCRL" -eq 1 ]; then
	# Always, even when only --revoke was asked for: the index is the thing
	# a revocation is written into, and a revocation against a missing row is
	# a revocation that silently does nothing.
	index_rebuild
	if [ -n "$REVOKE" ]; then
		case "$REVOKE_REASON" in
			""|unspecified|keyCompromise|CACompromise|affiliationChanged|superseded|cessationOfOperation|certificateHold|removeFromCRL|privilegeWithdrawn|AACompromise) ;;
			*) die "unknown --reason $REVOKE_REASON (unspecified|keyCompromise|CACompromise|affiliationChanged|superseded|cessationOfOperation|certificateHold|privilegeWithdrawn|AACompromise)" ;;
		esac
		if [ -f "$REVOKE" ]; then
			# openssl's own path: it reads the certificate, finds its row and
			# writes the reason the way it reads it back.
			rc=0
			if [ -n "$REVOKE_REASON" ]; then
				out="$(openssl ca -config "$CNF" -revoke "$REVOKE" -crl_reason "$REVOKE_REASON" \
					-batch 2>&1)" || rc=$?
			else
				out="$(openssl ca -config "$CNF" -revoke "$REVOKE" -batch 2>&1)" || rc=$?
			fi
			printf '%s\n' "$out" | sed 's/^/  /' >&2
			revoked_serial="$(openssl x509 -in "$REVOKE" -noout -serial | cut -d= -f2)"
			# Astra finding F13, 2026-09-23: `openssl ca -revoke` on a
			# certificate that is already revoked is not a mistake, it is a
			# retry -- `retire`/`keys revoke --host` revoke several
			# certificates in sequence and this is the one that ran before
			# and a second time is not a reason to abort before the rest
			# are taken back and the list is written. `--revoke <serial>`
			# already treats this the same way (see `revoke_serial`); the
			# file path did not.
			if [ "$rc" -eq 0 ]; then
				note "revoked: $revoked_serial"
			elif printf '%s' "$out" | grep -qi 'already revoked'; then
				note "already revoked: $revoked_serial"
			else
				die "openssl refused to revoke $REVOKE"
			fi
		else
			case "$REVOKE" in
				*/*|*.crt|*.pem) die "no such certificate: $REVOKE" ;;
			esac
			revoke_serial "$REVOKE" "$REVOKE_REASON"
		fi
	fi
	if [ "$GENCRL" -eq 1 ]; then
		openssl ca -config "$CNF" -gencrl -out "$DIR/crl.pem" -batch 2>&1 \
			| sed 's/^/  /' >&2 || die "openssl refused to write $DIR/crl.pem"
		number="$(openssl crl -in "$DIR/crl.pem" -noout -crlnumber 2>/dev/null | cut -d= -f2)"
		count="$(grep -c '^R' "$INDEX" || true)"
		note "crl:    $DIR/crl.pem (number ${number:-?}, $count revoked, $CRL_DAYS days)"
		printf '%s\n' "$DIR/crl.pem"
	fi
	exit 0
fi

bundle() { printf '%s\n' "$*" >> "$BUNDLE"; }

start_bundle() {
	BUNDLE="$DIR/bundle/$1.md"
	: > "$BUNDLE"
	bundle "# $1"
	bundle ""
	bundle "Files: \`$DIR/$1.crt\`, \`$DIR/$1.key\` (0600), CA \`$CA_CRT\`."
	bundle ""
}

toml_block() {
	bundle '## TOML'
	bundle ''
	bundle '```toml'
	printf '%s\n' "$@" >> "$BUNDLE"
	bundle '```'
	bundle ''
}

nix_block() {
	bundle '## NixOS'
	bundle ''
	bundle '```nix'
	printf '%s\n' "$@" >> "$BUNDLE"
	bundle '```'
	bundle ''
	bundle "The three PEM files are not in the Nix store — a key in the store is"
	bundle "world-readable. Ship them the way \`deploy/push.sh\` ships binaries, to"
	bundle "\`/etc/meisterstack/pki/\`, mode 0600 on the key."
}

# --- the halves, for a fleet with replicas ---------------------------------
#
# `--cloud`/`--cluster` below issue a serving certificate AND a tier identity
# under one name, which is right when one host is one tier and wrong the
# moment there are three of them: the serving certificate is what a client
# checks THIS ADDRESS against, and the tier identity is what the three
# replicas show as one another. So a plan asks for them separately.

for entry in "${SERVINGS[@]:-}"; do
	[ -n "$entry" ] || continue
	name="${entry%%:*}"; sans="${entry#"$name"}"; sans="${sans#:}"
	issue "$name" "/CN=$name/O=system:controllers" \
		"$SERVER_EXTS
subjectAltName=$(sans_of "$sans")"
done

for name in "${CLOUD_IDS[@]:-}"; do
	[ -n "$name" ] || continue
	# Shared by the replicas of one cloud on purpose: what it authorizes is a
	# replica reading from its sibling, and which of them answered is not a
	# question worth authorizing against.
	issue "system-cloud-$name" "/CN=system:cloud:$name/O=system:clouds" "$CLIENT_EXTS"
done

for name in "${CLUSTER_IDS[@]:-}"; do
	[ -n "$name" ] || continue
	# This is what the cloud checks the cluster's Hello against, and it names
	# the CLUSTER rather than the replica that happens to be dialling.
	issue "system-cluster-$name" "/CN=system:cluster:$name/O=system:clusters" "$CLIENT_EXTS"
done

# --- controllers -----------------------------------------------------------

for entry in "${CLOUDS[@]:-}"; do
	[ -n "$entry" ] || continue
	name="${entry%%:*}"; sans="${entry#"$name"}"; sans="${sans#:}"
	# Two certificates, for the same reason a cluster gets two. The serving
	# one is "this host"; the system:cloud one is "this CLOUD" — shared by
	# the three replicas, because what it authorizes is a replica reading
	# from its sibling and the three are interchangeable by design.
	issue "$name" "/CN=$name/O=system:controllers" \
		"$SERVER_EXTS
subjectAltName=$(sans_of "$sans")"
	issue "system-cloud-$name" "/CN=system:cloud:$name/O=system:clouds" "$CLIENT_EXTS"
	start_bundle "$name"
	toml_block \
		'# /etc/meisterstack/cloud.toml' \
		"cloud_name = \"$name\"" \
		"tls_cert = \"pki/$name.crt\"" \
		"tls_key  = \"pki/$name.key\"" \
		'client_ca = "pki/ca.crt"' \
		'# asking a sibling replica for a console or a log, as system:cloud:'"$name" \
		"identity_cert = \"pki/system-cloud-$name.crt\"" \
		"identity_key  = \"pki/system-cloud-$name.key\"" \
		'ca_cert   = "pki/ca.crt"' \
		'ca_key    = "pki/ca.key"' \
		'#csr_auto_approve = true   # lab only: signs every request that gets past the chain'
	nix_block \
		'meisterstack.cloud.settings = {' \
		"  cloud_name = \"$name\";" \
		"  tls_cert = \"/etc/meisterstack/pki/$name.crt\";" \
		"  tls_key = \"/etc/meisterstack/pki/$name.key\";" \
		'  client_ca = "/etc/meisterstack/pki/ca.crt";' \
		"  identity_cert = \"/etc/meisterstack/pki/system-cloud-$name.crt\";" \
		"  identity_key = \"/etc/meisterstack/pki/system-cloud-$name.key\";" \
		'  ca_cert = "/etc/meisterstack/pki/ca.crt";' \
		'  ca_key = "/etc/meisterstack/pki/ca.key";' \
		'};'
done

for entry in "${CLUSTERS[@]:-}"; do
	[ -n "$entry" ] || continue
	name="${entry%%:*}"; sans="${entry#"$name"}"; sans="${sans#:}"
	# Two certificates, because they are two identities. The serving one is
	# "this host"; the system:cluster one is "this cluster", and it is what
	# the cloud checks the Hello against.
	issue "$name" "/CN=$name/O=system:controllers" \
		"$SERVER_EXTS
subjectAltName=$(sans_of "$sans")"
	issue "system-cluster-$name" "/CN=system:cluster:$name/O=system:clusters" "$CLIENT_EXTS"
	start_bundle "$name"
	toml_block \
		'# /etc/meisterstack/cluster.toml' \
		"cluster_name = \"$name\"" \
		"tls_cert = \"pki/$name.crt\"" \
		"tls_key  = \"pki/$name.key\"" \
		'client_ca = "pki/ca.crt"' \
		'# dialling the cloud, as system:cluster:'"$name" \
		'cloud_ca   = "pki/ca.crt"' \
		"cloud_cert = \"pki/system-cluster-$name.crt\"" \
		"cloud_key  = \"pki/system-cluster-$name.key\""
	nix_block \
		'meisterstack.cluster.settings = {' \
		"  cluster_name = \"$name\";" \
		"  tls_cert = \"/etc/meisterstack/pki/$name.crt\";" \
		"  tls_key = \"/etc/meisterstack/pki/$name.key\";" \
		'  client_ca = "/etc/meisterstack/pki/ca.crt";' \
		'  cloud_ca = "/etc/meisterstack/pki/ca.crt";' \
		"  cloud_cert = \"/etc/meisterstack/pki/system-cluster-$name.crt\";" \
		"  cloud_key = \"/etc/meisterstack/pki/system-cluster-$name.key\";" \
		'};'
done

# --- nodes -----------------------------------------------------------------

for node in "${NODES[@]:-}"; do
	[ -n "$node" ] || continue
	stem="system-node-$node"
	issue "$stem" "/CN=system:node:$node/O=system:nodes" "$CLIENT_EXTS"
	start_bundle "$stem"
	bundle "The cluster-controller checks this CN against the node_id in the"
	bundle "agent's Hello: this certificate speaks for \`$node\` and for nothing else."
	bundle ""
	toml_block \
		'# /etc/meisterstack/agent.toml' \
		"node_id = \"$node\"" \
		'controller_ca   = "pki/ca.crt"' \
		"controller_cert = \"pki/$stem.crt\"" \
		"controller_key  = \"pki/$stem.key\"" \
		'# and the session address becomes https/grpcs at the controller end:' \
		'#controller_addrs = ["https://10.128.1.104:50051"]'
	nix_block \
		'meisterstack.agent.settings = {' \
		"  node_id = \"$node\";" \
		'  controller_ca = "/etc/meisterstack/pki/ca.crt";' \
		"  controller_cert = \"/etc/meisterstack/pki/$stem.crt\";" \
		"  controller_key = \"/etc/meisterstack/pki/$stem.key\";" \
		'};'
	bundle ""
	bundle "> The agent does not read these keys yet — its dial-out is still plain"
	bundle "> gRPC (M4.5 stopped at the controller side of that session). The"
	bundle "> certificate is here so the rollout is one config change, not a build."
done

# --- people ----------------------------------------------------------------

cli_bundle() {
	local stem="$1" who="$2"
	start_bundle "$stem"
	bundle "$who"
	bundle ""
	toml_block \
		'# ~/.config/meisterstack/config.toml' \
		"[profiles.$stem]" \
		'tier       = "cloud"' \
		'endpoint   = "https://10.128.1.103:3000"' \
		'ca_cert    = "pki/ca.crt"' \
		"credential = { type = \"mtls\", cert = \"pki/$stem.crt\", key = \"pki/$stem.key\" }"
	bundle "Renew with \`meister login --profile $stem\` — it writes a fresh pair to"
	bundle "exactly these two paths and never touches the config file."
}

for name in "${ADMINS[@]:-}"; do
	[ -n "$name" ] || continue
	issue "$name" "/CN=$name/O=system:masters" "$CLIENT_EXTS"
	cli_bundle "$name" \
		"Break glass: \`system:masters\` is above the user directory and answers to
no User object. Use it to create the first tenant and the first user, then
work as an ordinary admin."
done

for entry in "${USERS[@]:-}"; do
	[ -n "$entry" ] || continue
	name="${entry%%:*}"; role="${entry#"$name"}"; role="${role#:}"; role="${role:-member}"
	case "$role" in
		admin)    group="meister:admins" ;;
		operator) group="meister:operators" ;;
		member)   group="meister:members" ;;
		viewer)   group="meister:viewers" ;;
		*) die "unknown role $role for user $name (admin|operator|member|viewer)" ;;
	esac
	issue "$name" "/CN=$name/O=$group" "$CLIENT_EXTS"
	cli_bundle "$name" \
		"Role \`$role\` (\`$group\`). The group in the certificate is labelling and
not a permission -- the \`User\` object at the cloud is the only thing anything
consults -- so create it, or this certificate authorizes nothing:

    meister user create $name --tenant <tenant> --role $role"
done

printf '\n' >&2
note "ca:      $CA_CRT"
note "bundles: $DIR/bundle/"
