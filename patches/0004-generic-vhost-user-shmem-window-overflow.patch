-        Ok(self.host_addr + region.offset + offset)
+        // The region list comes from the VMM, not from this request; a region
+        // reaching past the window must still never yield an address outside it.
+        let Some(window_offset) = self.window_offset(region, offset, len) else {
+            let window_len = self.window_len;
+            error!(
+                "shared memory request {offset:#x}+{len:#x} in shmid {shmid} lies outside the window of {window_len:#x} bytes"
+            );
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        };
+        Ok(self.host_addr + window_offset)
+    }
+
+    /// Window offset of `offset..offset + len` in `region`, if the range lies
+    /// inside the window.
+    fn window_offset(&self, region: &VirtioSharedMemory, offset: u64, len: u64) -> Option<u64> {
+        let start = region.offset.checked_add(offset)?;
+        (start.checked_add(len)? <= self.window_len).then_some(start)
     }
 
