+/// Allocate a generic vhost-user shared memory window of `size` bytes, aligned
+/// to its size, from a 64-bit PCI aperture. The backend chose the size, so a
+/// window the whole aperture cannot hold is reported as such.
+fn allocate_shmem_window(
+    mem64_allocator: &Mutex<AddressAllocator>,
+    size: u64,
+) -> DeviceManagerResult<u64> {
+    let mut allocator = mem64_allocator.lock().unwrap();
+    // end() is inclusive; an aperture spanning all of u64 saturates.
+    let aperture = (allocator.end().0 - allocator.base().0).saturating_add(1);
+    if size > aperture {
+        return Err(DeviceManagerError::GenericVhostUserShmemWindowTooLarge {
+            window: size,
+            aperture,
+        });
+    }
+    allocator
+        .allocate(None, size as GuestUsize, Some(size as GuestUsize))
+        .map(|base| base.raw_value())
+        .ok_or(DeviceManagerError::GenericVhostUserShmemAllocation)
+}
