+/// Where the VIRTIO Shared Memory Regions sit in the window that backs them.
+#[derive(Clone)]
+pub struct ShmemLayout {
+    /// Window length in bytes, a power of two: the window is a PCI BAR.
+    pub window_len: u64,
+    /// Regions indexed by shmid, back to back from offset 0; a zero length
+    /// marks an unused shmid.
+    pub regions: Vec<VirtioSharedMemory>,
+}
+
+impl ShmemLayout {
+    /// Lay out regions of `sizes`, indexed by shmid. The backend picks the
+    /// sizes, so the running offset and the power of two above the total are
+    /// checked: a wrapped value would give a window smaller than its regions.
+    fn new(sizes: &[u64]) -> Result<Self> {
+        let mut regions = Vec::with_capacity(sizes.len());
+        let mut end: u64 = 0;
+        for &len in sizes {
+            regions.push(VirtioSharedMemory { offset: end, len });
+            end = end.checked_add(len).ok_or_else(|| {
+                Error::VhostUserInvalidShmemConfig(
+                    "the region sizes add up to more than 2^64 bytes".to_string(),
+                )
+            })?;
+        }
+        let window_len = end.checked_next_power_of_two().ok_or_else(|| {
+            Error::VhostUserInvalidShmemConfig(format!(
+                "a power-of-two window for {end:#x} bytes of regions exceeds 2^64 bytes"
+            ))
+        })?;
+        Ok(ShmemLayout {
+            window_len,
+            regions,
+        })
+    }
+}
+
 /// Lay an inaccessible anonymous mapping over `len` bytes at `addr`.
