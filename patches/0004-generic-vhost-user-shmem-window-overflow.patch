+    #[test]
+    fn shmem_layout_places_the_regions_back_to_back() {
+        let p = page_size();
+        let layout = ShmemLayout::new(&[0, 4 * p, p]).unwrap();
+        let regions: Vec<_> = layout.regions.iter().map(|r| (r.offset, r.len)).collect();
+        assert_eq!(regions, [(0, 0), (0, 4 * p), (4 * p, p)]);
