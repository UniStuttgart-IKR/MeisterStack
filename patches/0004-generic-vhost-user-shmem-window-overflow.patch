+    fn shmem_layout_refuses_sizes_whose_window_overflows() {
+        let p = page_size();
+        let half = 1u64 << 63;
+        assert!(
+            ShmemLayout::new(&[half, half, p]).is_err(),
+            "unchecked, the total wrapped to one page and so did the window"
